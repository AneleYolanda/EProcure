@*
    Bidder (supplier) and public pages. The design is a phone app: full width on a phone,
    a centred 480px column on bigger screens. Signed-in suppliers get the bottom tab bar
    unless a page sets ViewData["HideTabBar"] = true (e.g. Verify phone).
*@
@{
    var showTabBar = User.Identity?.IsAuthenticated == true
                     && User.IsInRole(AppRoles.Supplier)
                     && ViewData["HideTabBar"] as bool? != true;
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#1B2A4A" />
    <title>@ViewData["Title"] · eProcure</title>
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/eprocure.css" asp-append-version="true" />
</head>
<body class="ep-body">
    <div class="ep-app">
        <main class="ep-screen@(ViewData["ScreenClass"] is string extra ? " " + extra : "")">
            @RenderBody()
        </main>
        @if (showTabBar)
        {
            <partial name="~/Views/Shared/Partials/_TabBar.cshtml" />
        }
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
