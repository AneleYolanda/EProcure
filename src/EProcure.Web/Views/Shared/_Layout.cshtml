@using EProcure.Web.Domain
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eProcure</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="marketplace-shell">
    <header class="marketplace-header">
        <nav class="container navbar navbar-expand-md" aria-label="Main navigation">
            <a class="wordmark" asp-area="" asp-controller="Home" asp-action="Index">eProcure</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavigation">
                <div class="navbar-nav ms-auto align-items-md-center gap-md-2">
                    <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Tenders</a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole(AppRoles.Supplier))
                        {
                            <a class="nav-link" asp-area="Supplier" asp-controller="Dashboard" asp-action="Index">My applications</a>
                            <a class="nav-link" href="#company-profile">Company</a>
                        }
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link nav-link">Log out</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Login">Log in</a>
                        <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <main class="container marketplace-main" role="main">
        @RenderBody()
    </main>
    <footer class="marketplace-footer">
        <div class="container d-flex justify-content-between gap-3 flex-wrap">
            <span>&copy; 2026 eProcure</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">POPIA privacy notice</a>
        </div>
    </footer>
    @if (User.Identity?.IsAuthenticated == true && User.IsInRole(AppRoles.Supplier))
    {
        <nav class="supplier-bottom-nav" aria-label="Supplier navigation">
            <a asp-area="" asp-controller="Home" asp-action="Index"><span>Tenders</span></a>
            <a asp-area="Supplier" asp-controller="Dashboard" asp-action="Index"><span>My applications</span></a>
            <a href="#company-profile"><span>Company</span></a>
            <a asp-area="" asp-controller="Account" asp-action="AccessDenied"><span>Account</span></a>
        </nav>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>