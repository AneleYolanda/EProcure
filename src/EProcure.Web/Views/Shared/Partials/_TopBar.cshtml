@*
    Screen header: back chevron, title and optional meta on the right (e.g. "Step 2 of 2").
    Reads ViewData["BackUrl"], ViewData["Title"] and ViewData["TopBarMeta"].
*@
@{
    var backUrl = ViewData["BackUrl"] as string;
    var meta = ViewData["TopBarMeta"] as string;
}
<header class="ep-topbar">
    @if (!string.IsNullOrEmpty(backUrl))
    {
        <a class="ep-topbar__back" href="@backUrl" aria-label="Back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
        </a>
    }
    <h1 class="ep-topbar__title">@ViewData["Title"]</h1>
    @if (!string.IsNullOrEmpty(meta))
    {
        <span class="ep-topbar__meta">@meta</span>
    }
</header>
