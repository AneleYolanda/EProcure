@* Design screen "sOtp". Six boxes (Identity's phone codes have 6 digits; the prototype shows 5).
   Every box is a form field named "Digits", so the page also works without JavaScript. *@
@model EProcure.Web.ViewModels.Account.VerifyPhoneViewModel
@{
    ViewData["Title"] = "Verify your number";
    ViewData["HideTabBar"] = true;
}
<div class="ep-auth">
    <div class="ep-otp__icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#1CA3EC" stroke-width="1.5" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2.5" /><path d="M10.5 18.5h3" /></svg>
    </div>
    <h1 class="ep-otp__title">Verify your number</h1>
    <p class="ep-otp__text">We sent a 6-digit code to <strong>@Model.PhoneDisplay</strong>. Your account is ready to use once the code is verified.</p>

    @if (Model.DemoCode is not null)
    {
        <div class="ep-demo-box ep-mt-18" role="status">
            <strong>DEMO MODE · NO SMS WAS SENT</strong>
            Your code is <code>@Model.DemoCode</code>
        </div>
    }

    <form asp-controller="Account" asp-action="VerifyPhone" method="post">
        <div asp-validation-summary="ModelOnly" class="ep-mt-18"></div>
        <fieldset class="ep-otp__boxes" data-ep-otp>
            <legend class="ep-visually-hidden">Verification code, one digit per box</legend>
            @for (var i = 0; i < 6; i++)
            {
                <input class="ep-otp__box" name="Digits" inputmode="numeric" pattern="[0-9]" maxlength="1"
                       autocomplete="@(i == 0 ? "one-time-code" : "off")" aria-label="Digit @(i + 1) of 6" />
            }
        </fieldset>
        <button type="submit" class="ep-btn ep-btn--primary ep-mt-26">Verify and continue</button>
    </form>

    <form asp-controller="Account" asp-action="ResendCode" method="post" class="ep-otp__resend">
        <button type="submit" class="ep-textbtn ep-textbtn--muted">Resend code</button>
    </form>

    <div class="ep-auth__spacer"></div>
    <form asp-controller="Account" asp-action="Logout" method="post" class="ep-otp__resend">
        <button type="submit" class="ep-textbtn ep-textbtn--muted">Sign out</button>
    </form>
</div>
