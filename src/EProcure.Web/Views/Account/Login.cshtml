@* Design screen "sLogin" (bidder app). Organisation staff can also sign in here;
   they have their own branded entrance at /admin/{orgCode}/login as well. *@
@model EProcure.Web.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Shell"] = "auth";
}
<div class="ep-auth">
    <partial name="~/Views/Shared/Partials/_Wordmark.cshtml" model="@("")" />
    <div class="ep-auth__tagline">Procurement, simplified.</div>

    <h1 class="ep-auth__title">Sign in</h1>
    <div class="ep-auth__sub">Use the email address registered to your profile.</div>

    @if (TempData["Flash"] is string flash)
    {
        <div class="ep-flash ep-mt-26" role="status">@flash</div>
    }

    <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" class="ep-mt-26">
        <div asp-validation-summary="ModelOnly"></div>
        <div class="ep-fields ep-mt-14">
            <label class="ep-field" asp-for="Email">EMAIL ADDRESS
                <input class="ep-input" asp-for="Email" placeholder="you@company.co.za" autocomplete="username" />
                <span asp-validation-for="Email"></span>
            </label>
            <label class="ep-field" asp-for="Password">PASSWORD
                <input class="ep-input" asp-for="Password" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </label>
        </div>
        <button type="submit" class="ep-btn ep-btn--primary ep-mt-26">Sign in</button>
    </form>

    <div class="ep-auth__links">
        <a class="ep-textbtn" asp-controller="Account" asp-action="Register">Register</a>
        <a class="ep-textbtn" asp-controller="Account" asp-action="ForgotPassword">Forgot your password?</a>
    </div>

    <div class="ep-auth__spacer"></div>
    <div class="ep-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#1CA3EC" stroke-width="1.5" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 018 0v3" /></svg>
        <span>POPIA compliant. Card details are never stored by eProcure — payments are handled by the gateway.</span>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
