@* Password reset, step 1: ask for the email address. The answer never reveals whether the address has an account. *@
@model EProcure.Web.ViewModels.Account.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Reset your password";
    ViewData["Shell"] = "auth";
}
<div class="ep-auth">
    <partial name="~/Views/Shared/Partials/_Wordmark.cshtml" model="@("")" />
    <div class="ep-auth__tagline">Procurement, simplified.</div>

    @if (TempData["FlashError"] is string flashError)
    {
        <div class="ep-flash ep-flash--error ep-mt-26" role="alert">@flashError</div>
    }

    @if (Model.Sent)
    {
        <h1 class="ep-auth__title">Check your email</h1>
        <div class="ep-auth__sub">
            If <strong>@Model.Email</strong> belongs to an eProcure account, we have sent it a link to choose a new password.
            The link works once and expires in 1 hour. Nothing arrived? Check the spam folder, or ask again.
        </div>
        @if (Model.ShowDemoMailbox)
        {
            <div class="ep-demo-box ep-mt-26" role="note">
                <strong>DEMO MODE</strong> No real email is sent. Open the <a href="/dev/mailbox" target="_blank" rel="noopener">demo mailbox</a> to use the link.
            </div>
        }
        <a class="ep-btn ep-btn--primary ep-mt-26" asp-action="Login">Back to sign in</a>
    }
    else
    {
        <h1 class="ep-auth__title">Reset your password</h1>
        <div class="ep-auth__sub">Enter the email address of your eProcure account. We will email you a link to choose a new password.</div>

        <form asp-action="ForgotPassword" method="post" class="ep-mt-26">
            <div asp-validation-summary="ModelOnly"></div>
            <div class="ep-fields ep-mt-14">
                <label class="ep-field" asp-for="Email">EMAIL ADDRESS
                    <input class="ep-input" asp-for="Email" placeholder="you@company.co.za" autocomplete="username" />
                    <span asp-validation-for="Email"></span>
                </label>
            </div>
            <button type="submit" class="ep-btn ep-btn--primary ep-mt-26">Email me a reset link</button>
        </form>

        <div class="ep-auth__links">
            <a class="ep-textbtn" asp-action="Login">Back to sign in</a>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
