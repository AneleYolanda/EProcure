@* Choosing a password from an emailed link: a password reset, or a staff invitation (same form, different words). *@
@model EProcure.Web.ViewModels.Account.SetPasswordViewModel
@{
    ViewData["Title"] = Model.IsInvitation ? "Choose your password" : "Choose a new password";
    ViewData["Shell"] = "auth";
}
<div class="ep-auth">
    <partial name="~/Views/Shared/Partials/_Wordmark.cshtml" model="@("")" />
    <div class="ep-auth__tagline">Procurement, simplified.</div>

    <h1 class="ep-auth__title">@ViewData["Title"]</h1>
    <div class="ep-auth__sub">@(Model.Greeting ?? "Use at least 10 characters. A phrase of a few words is easy to remember and hard to guess.")</div>

    <form asp-action="@(Model.IsInvitation ? "AcceptInvite" : "ResetPassword")" method="post" class="ep-mt-26">
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="Code" />
        <div asp-validation-summary="ModelOnly"></div>
        <div class="ep-fields ep-mt-14">
            <label class="ep-field" asp-for="Password">NEW PASSWORD
                <input class="ep-input" asp-for="Password" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </label>
            <label class="ep-field" asp-for="ConfirmPassword">TYPE IT AGAIN
                <input class="ep-input" asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </label>
        </div>
        <button type="submit" class="ep-btn ep-btn--primary ep-mt-26">@(Model.IsInvitation ? "Set password" : "Change password")</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
