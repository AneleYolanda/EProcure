@* Design screen "sSplash" (bidder app). Continues to sign-in after 2.5 s; Skip goes there at once.
   Without JavaScript the Skip link still works. *@
@{
    ViewData["Title"] = "Procurement, simplified";
    ViewData["Shell"] = "splash";
    var loginUrl = Url.Action("Login", "Account")!;
}
<div class="ep-splash" data-ep-autocontinue="@loginUrl" data-ep-delay="2500">
    <img class="ep-splash__photo" src="~/img/brand/splash.jpg" alt="" />
    <div class="ep-splash__shade"></div>
    <div class="ep-splash__content">
        <h1 class="ep-visually-hidden">eProcure</h1>
        <partial name="~/Views/Shared/Partials/_Wordmark.cshtml" model="@("ep-wordmark--xl ep-wordmark--light")" />
        <div class="ep-splash__tagline">Procurement, simplified.</div>
        <div class="ep-splash__line"></div>
    </div>
    <div class="ep-splash__foot">Secure procurement platform · South Africa</div>
    <a class="ep-splash__skip" href="@loginUrl">Skip</a>
</div>
