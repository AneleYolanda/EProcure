@* One received application: company, SBD answers with red flags, the uploaded documents (download is
   audited), status history, and the status change form for SCM Officers. The system records decisions;
   it does not score or choose a winner. *@
@model ReceivedApplicationViewModel
@{
    ViewData["Title"] = Model.ReferenceNumber ?? "Application";
    ViewData["Nav"] = "applications";
}
<div class="ep-stack">
    @if (TempData["Flash"] is string flash)
    {
        <div class="ep-flash" role="status">@flash</div>
    }
    @if (TempData["FlashError"] is string flashError)
    {
        <div class="ep-flash ep-flash--error" role="alert">@flashError</div>
    }

    <div class="ep-detail">
        <div class="ep-detail__main">
            <section class="ep-section">
                <div class="ep-detail__head">
                    <div class="ep-grow">
                        <div class="ep-detail__ref">@Model.ReferenceNumber · <a asp-controller="Tenders" asp-action="Details" asp-route-id="@Model.TenderId">@Model.TenderReference</a></div>
                        <h2 class="ep-detail__title">@Model.CompanyName</h2>
                        <div class="ep-detail__meta">@Model.TenderTitle · submitted @(Model.SubmittedAtUtc is DateTime at ? DisplayFormat.DateTime(at) : "—") · @Model.PaymentText</div>
                    </div>
                    <span class="@SubmissionStatuses.BadgeCss(Model.Status)">@SubmissionStatuses.Label(Model.Status)</span>
                </div>
                @if (Model.RedFlags.Count > 0)
                {
                    <div class="ep-warning-note ep-mt-18">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B4791C" stroke-width="1.7" aria-hidden="true"><path d="M12 3l9 16H3l9-16z" /><path d="M12 9v5" /><path d="M12 16.5v.5" /></svg>
                        <div><strong>For the committee's attention:</strong> @string.Join(" · ", Model.RedFlags). These are the bidder's own declarations; eProcure does not reject bids automatically.</div>
                    </div>
                }
            </section>

            <section class="ep-section">
                <h3 class="ep-section__title">Documents (@Model.Documents.Count)</h3>
                <div class="ep-section__sub">Downloads are recorded in the audit trail. The fingerprint (SHA-256) proves a file has not changed since it was submitted.</div>
                <ul class="ep-doclist">
                    @foreach (var d in Model.Documents)
                    {
                        <li>
                            <span class="ep-grow"><span class="ep-docrow__name">@d.Requirement</span><span class="ep-docrow__meta">@d.FileName · @Math.Max(1, d.SizeBytes / 1024) KB · uploaded @DisplayFormat.DateTime(d.UploadedAtUtc) · fingerprint @d.Sha256Short…</span></span>
                            <a class="ep-abtn" asp-action="Document" asp-route-id="@d.Id">Download PDF</a>
                        </li>
                    }
                </ul>
            </section>

            <section class="ep-section">
                <h3 class="ep-section__title">SBD answers and declarations</h3>
                <div class="ep-kvs">
                    @foreach (var (question, answer, flag) in Model.Answers)
                    {
                        <div class="ep-kv"><span class="ep-kv__k">@question</span><span class="ep-kv__v">@answer @if (flag) {<span class="ep-badge ep-badge--warning">Check</span>}</span></div>
                    }
                </div>
            </section>

            <section class="ep-section">
                <h3 class="ep-section__title">Bidding company</h3>
                <div class="ep-kvs">
                    @foreach (var (key, value) in Model.CompanyFields)
                    {
                        <div class="ep-kv"><span class="ep-kv__k">@key</span><span class="ep-kv__v">@value</span></div>
                    }
                    <div class="ep-kv"><span class="ep-kv__k">Submitted by</span><span class="ep-kv__v">@Model.ContactName · @Model.ContactEmail</span></div>
                </div>
            </section>
        </div>

        <aside class="ep-detail__side">
            @if (Model.CanChangeStatus && Model.AllowedNext.Count > 0)
            {
                <section class="ep-side-card" aria-labelledby="status-title">
                    <h3 class="ep-side-card__title" id="status-title">Record a status change</h3>
                    <div class="ep-side-card__text">The supplier sees the new status and your note on their application. Award decisions are recorded separately and are never made by the system.</div>
                    <form asp-action="ChangeStatus" asp-route-id="@Model.Id" method="post" class="ep-mt-14">
                        <div class="ep-radio-pills">
                            @foreach (var next in Model.AllowedNext)
                            {
                                <label class="ep-radio-pill"><input type="radio" name="NewStatus" value="@next" required /><span>@SubmissionStatuses.Label(next)</span></label>
                            }
                        </div>
                        <label class="ep-afield ep-mt-14">NOTE FOR THE SUPPLIER AND THE RECORD
                            <textarea class="ep-ainput" name="Note" rows="3" maxlength="1000" required placeholder="e.g. Bid opened by the BEC on 05 Oct 2026"></textarea>
                        </label>
                        <button type="submit" class="ep-abtn ep-abtn--primary ep-abtn--block">Save status</button>
                    </form>
                </section>
            }
            else if (!Model.CanChangeStatus)
            {
                <section class="ep-side-card">
                    <h3 class="ep-side-card__title">Read-only</h3>
                    <div class="ep-side-card__text">BEC members can read applications and download documents. Status changes are recorded by the SCM Officer.</div>
                </section>
            }

            <section class="ep-side-card" aria-labelledby="timeline-title">
                <h3 class="ep-side-card__title" id="timeline-title">Application history</h3>
                <div class="ep-timeline">
                    @foreach (var (what, who, when) in Model.Timeline)
                    {
                        <div class="ep-timeline__item">
                            <div class="ep-timeline__rail"><span class="ep-timeline__dot"></span><span class="ep-timeline__line"></span></div>
                            <div class="ep-timeline__body">
                                <div class="ep-timeline__what">@what</div>
                                <div class="ep-timeline__who">@who · @DisplayFormat.DateTime(when)</div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>
