@* Design screen "sFeed": search, "All tenders" tab, category chips, tender cards.
   The search and chips are ordinary GET links/forms, so they work without JavaScript and can be bookmarked. *@
@model SupplierDashboardViewModel
@{
    ViewData["Title"] = "Tenders";
    ViewData["Tab"] = "tenders";
    ViewData["ScreenClass"] = "ep-screen--page";
}
<header class="ep-feed-head">
    @* Computers: a page heading (the top navigation bar already shows the wordmark). *@
    <div class="ep-feed-head__title">
        <h1 class="ep-page-title">Open tenders</h1>
        <p class="ep-page-sub">@Model.Tenders.Count open @(Model.Tenders.Count == 1 ? "tender" : "tenders") from @Model.Tenders.Select(t => t.OrganisationName).Distinct().Count() public-sector @(Model.Tenders.Select(t => t.OrganisationName).Distinct().Count() == 1 ? "organisation" : "organisations")@(Model.CompanyName is null ? "" : $" · checked against {Model.CompanyName}")</p>
    </div>
    @* Phones: the design's app header with the wordmark. *@
    <div class="ep-feed-head__row">
        <partial name="~/Views/Shared/Partials/_Wordmark.cshtml" model="@("ep-wordmark--sm")" />
        <span class="ep-grow"></span>
        @if (Model.CompanyName is not null)
        {
            <a class="ep-company-tile" asp-area="Supplier" asp-controller="Company" asp-action="Index" title="Bidding as @Model.CompanyName">
                <span class="ep-company-tile__initials">@DisplayFormat.Initials(Model.CompanyName)</span>
                <span class="ep-visually-hidden">Bidding as @Model.CompanyName</span>
            </a>
        }
    </div>
    <form method="get" asp-area="Supplier" asp-controller="Dashboard" asp-action="Index" role="search">
        <label class="ep-search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#5A6B7B" stroke-width="1.6" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M16.5 16.5L21 21" /></svg>
            <span class="ep-visually-hidden">Search tenders</span>
            <input type="search" name="q" value="@Model.Query" placeholder="Search tenders, organisations, reference" />
        </label>
        @if (Model.Category is not null)
        {
            <input type="hidden" name="category" value="@Model.Category" />
        }
    </form>
    <nav class="ep-tabs" aria-label="Feed">
        <a class="ep-tabs__tab ep-tabs__tab--active" aria-current="page" asp-area="Supplier" asp-controller="Dashboard" asp-action="Index">All tenders</a>
    </nav>
</header>
@if (ViewData["ComplianceAlert"] is string complianceAlert)
{
    <div class="ep-flash ep-flash--error" role="status">@complianceAlert <a asp-area="Supplier" asp-controller="Company" asp-action="Compliance">Update documents</a></div>
}

<nav class="ep-filter-chips" aria-label="Filter by category">
    <a class="ep-filter-chip@(Model.Category is null ? " ep-filter-chip--active" : "")"
       asp-area="Supplier" asp-controller="Dashboard" asp-action="Index" asp-route-q="@Model.Query">All</a>
    @foreach (var category in Model.Categories)
    {
        <a class="ep-filter-chip@(Model.Category == category ? " ep-filter-chip--active" : "")"
           asp-area="Supplier" asp-controller="Dashboard" asp-action="Index" asp-route-q="@Model.Query" asp-route-category="@category">@category</a>
    }
</nav>

@if (Model.CompanyName is null)
{
    <div class="ep-info-strip"><a asp-area="Supplier" asp-controller="Company" asp-action="Create">Add your company</a> to see which tenders <strong>you qualify for</strong>.</div>
}

<section class="ep-tender-list" aria-label="Tenders">
    @foreach (var tender in Model.Tenders)
    {
        <partial name="~/Views/Shared/Partials/_TenderCard.cshtml" model="tender" />
    }
    @if (Model.Tenders.Count == 0)
    {
        <div class="ep-empty">@(string.IsNullOrWhiteSpace(Model.Query) && Model.Category is null ? "There are no open tenders right now." : "No tenders match that search.")</div>
    }
</section>
