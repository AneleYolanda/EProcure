@* Design screen "sSettings". Rows for features that do not exist yet are shown as "Soon" and are not links. *@
@model SupplierProfileViewModel
@{
    ViewData["Title"] = "Profile";
    ViewData["Tab"] = "profile";
    ViewData["ScreenClass"] = "ep-screen--page";
}
<header class="ep-page-head">
    <h1 class="ep-page-head__title">Profile</h1>
    <div class="ep-person">
        <span class="ep-person__tile" aria-hidden="true">@DisplayFormat.Initials(Model.FullName)</span>
        <span>
            <span class="ep-person__name">@Model.FullName</span>
            <span class="ep-person__email">@Model.Email</span>
        </span>
    </div>
</header>

<div class="ep-screen__body">
    <div class="ep-rows">
        <div class="ep-row">
            <span class="ep-row__text">
                <span class="ep-row__label">Company<span class="ep-soon-pill">Soon</span></span>
                <span class="ep-row__meta">@(Model.CompanyName is null ? "No company on this profile yet" : $"{Model.CompanyName} · {Model.CompanyMeta}")</span>
            </span>
        </div>
        <div class="ep-row">
            <span class="ep-row__text">
                <span class="ep-row__label">Cellphone</span>
                <span class="ep-row__meta">@Model.Cellphone · verified</span>
            </span>
        </div>
        <a class="ep-row" asp-area="" asp-controller="Home" asp-action="Privacy">
            <span class="ep-row__text">
                <span class="ep-row__label">POPIA and consent</span>
                <span class="ep-row__meta">@(Model.PopiaConsentAtUtc is DateTime consented ? $"Consent given {DisplayFormat.Date(consented)} · read what we collect" : "Read what we collect")</span>
            </span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#B9CBDA" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
        </a>
    </div>

    <div class="ep-card">
        <div class="ep-icon-row">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#1CA3EC" stroke-width="1.5" aria-hidden="true"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V7a4 4 0 018 0v3" /></svg>
            <div>
                <h2 class="ep-card__title">Security</h2>
                <p class="ep-card__text">Your sign-in lasts up to 8 hours and is renewed while you are active. After 5 wrong passwords the account locks for 15 minutes. Card numbers are never stored by eProcure. Actions on your account are logged for audit.</p>
            </div>
        </div>
    </div>

    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
        <button type="submit" class="ep-btn ep-btn--danger-outline">Sign out</button>
    </form>
</div>
